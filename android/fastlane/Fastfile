# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# To deploy your app using fastlane, run the following command from the android folder
# cd android
# fastlane deploy

default_platform(:android)

# Root of the Flutter project (two levels above this file).
FLUTTER_ROOT_DIR = File.expand_path("../..", __dir__)

platform :android do
  desc "Build the release app bundle and upload it to the Google Play internal track"
  lane :deploy do
    Dir.chdir(FLUTTER_ROOT_DIR) do
      sh("flutter", "build", "appbundle", "--release")
    end

    upload_to_play_store(
      track: "internal", # internal, alpha, beta, production
      aab: "#{FLUTTER_ROOT_DIR}/build/app/outputs/bundle/release/app-release.aab"
    )
  end
end
